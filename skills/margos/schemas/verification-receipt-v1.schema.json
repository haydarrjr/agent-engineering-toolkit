{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARGOS Verification Receipt v1",
  "type": "object",
  "required": [
    "schema_version", "opportunity_id", "admission", "mandatory_candidate_ids",
    "selected_optional_candidate_ids", "skipped_optional_candidate_ids",
    "dispatched_operation_ids", "provider_request_count", "dispatch_matches_plan",
    "report_protection", "fingerprints"
  ],
  "properties": {
    "schema_version": {"const": "margos-verification-receipt/v1"},
    "opportunity_id": {"type": "string"},
    "admission": {"type": "object", "required": ["decision", "reason"], "properties": {"decision": {"enum": ["CALL_REFLEX", "SKIP"]}, "reason": {"type": "string"}, "detail": {"type": "string"}}, "additionalProperties": true},
    "mandatory_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "selected_optional_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "skipped_optional_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "dispatched_operation_ids": {"type": "array", "items": {"type": "string"}},
    "provider_request_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "dispatch_matches_plan": {"type": "boolean"},
    "report_protection": {"type": "object", "required": ["verified_candidates_excluded_from_optional", "jev_did_not_rank_findings"], "properties": {"verified_candidates_excluded_from_optional": {"type": "boolean"}, "jev_did_not_rank_findings": {"type": "boolean"}}, "additionalProperties": false},
    "fingerprints": {"type": "object", "required": ["question_set_sha256", "threshold_policy_sha256", "projection_version", "calibration_binding_hash", "cost_model_version"], "properties": {"question_set_sha256": {"type": "string"}, "threshold_policy_sha256": {"type": "string"}, "projection_version": {"type": "string"}, "calibration_binding_hash": {"type": "string"}, "cost_model_version": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
