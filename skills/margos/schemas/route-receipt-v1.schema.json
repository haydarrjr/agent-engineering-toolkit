{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MARGOS Route Receipt v1",
  "type":"object",
  "required":["schema_version","decision_authority","state_sha256","policy_version","question_set_version","question_set_sha256","threshold_policy_version","threshold_policy_sha256","provider","admissible","blocked","policy_rules_applied","reflex","selected","host_execution"],
  "properties":{
    "schema_version":{"const":"margos-route-receipt/v1"},
    "decision_authority":{"const":"PROPOSED"},
    "state_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_version":{"const":"margos-policy/v1"},
    "question_set_version":{"const":"margos-questions/v1"},
    "question_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "threshold_policy_version":{"const":"margos-thresholds/v1"},
    "threshold_policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "provider":{"type":"object"},
    "admissible":{"type":"object"},
    "blocked":{"type":"array"},
    "policy_rules_applied":{"type":"array"},
    "reflex":{"type":"object"},
    "selected":{"type":"object"},
    "host_execution":{"type":"object","required":["status"],"properties":{"status":{"enum":["PENDING","OBSERVED","UNKNOWN","FAILED"]}},"additionalProperties":true},
    "context_binding":{
      "type":"object",
      "required":["status","child_id","role","context_receipt_schema_version","context_receipt_sha256","context_bundle_sha256","parent_context_receipt_sha256"],
      "properties":{
        "status":{"const":"BOUND"},
        "child_id":{"type":"string","minLength":1},
        "role":{"enum":["SCOUT","WORKER","VERIFIER","INDEPENDENT_CRITIC"]},
        "context_receipt_schema_version":{"const":"margos-child-context-receipt/v1"},
        "context_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "context_bundle_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "parent_context_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
