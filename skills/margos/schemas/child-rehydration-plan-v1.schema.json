{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARGOS Child Rehydration Plan v1",
  "type": "object",
  "required": ["schema_version", "authority", "child_id", "role", "bundle_sha256", "requests", "canonical_source_mutated"],
  "properties": {
    "schema_version": {"const": "margos-child-rehydration-plan/v1"},
    "authority": {"const": "REQUEST_ONLY"},
    "child_id": {"type": "string"},
    "role": {"enum": ["SCOUT", "WORKER", "VERIFIER", "INDEPENDENT_CRITIC"]},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "reason", "status", "contract"],
        "properties": {
          "item_id": {"type": "string"},
          "reason": {"type": "string"},
          "status": {"enum": ["READY", "PENDING_AUTHORITY_RECHECK", "REJECTED_NOT_EXPOSED", "REJECTED_UNAVAILABLE"]},
          "contract": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    },
    "canonical_source_mutated": {"const": false}
  },
  "additionalProperties": false
}
