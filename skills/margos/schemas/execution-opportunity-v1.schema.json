{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARGOS Execution Opportunity v1",
  "type": "object",
  "required": ["schema_version", "opportunity_id", "fallback_operation_id", "candidates", "critical_path", "host_can_exploit_result", "jev_latency_budget_ms", "cost_model_version"],
  "properties": {
    "schema_version": {"const": "margos-execution-opportunity/v1"},
    "opportunity_id": {"type": "string", "minLength": 1},
    "fallback_operation_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_id", "coordination", "compute", "host_capability_proof", "cost"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "coordination": {"type": "string", "minLength": 1},
          "compute": {"type": "string", "minLength": 1},
          "role": {"type": ["string", "null"]},
          "host_capability_proof": {"type": "string", "minLength": 1},
          "cost": {
            "type": "object",
            "required": ["latency_ms_p50", "latency_ms_p95", "model_tokens", "money_microunits", "retrieval_bytes", "verification_cost_units"],
            "properties": {
              "latency_ms_p50": {"type": "number", "minimum": 0},
              "latency_ms_p95": {"type": "number", "minimum": 0},
              "model_tokens": {"type": "number", "minimum": 0},
              "money_microunits": {"type": "number", "minimum": 0},
              "retrieval_bytes": {"type": "number", "minimum": 0},
              "verification_cost_units": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "critical_path": {"type": "boolean"},
    "host_can_exploit_result": {"type": "boolean"},
    "jev_latency_budget_ms": {"type": "number", "minimum": 0},
    "jev_cost_budget_microunits": {"type": "number", "minimum": 0},
    "cost_model_version": {"type": "string", "minLength": 1},
    "cache_lookup_status": {"enum": ["MISS", "HIT", "NOT_CHECKED"]}
  },
  "additionalProperties": false
}
