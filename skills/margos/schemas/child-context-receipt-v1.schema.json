{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARGOS Child Context Receipt v1",
  "type": "object",
  "required": [
    "schema_version", "authority", "handoff_policy_version", "child_id", "role",
    "route_receipt_sha256", "parent_context_receipt_sha256",
    "parent_context_view_sha256", "bundle_sha256", "required_item_ids",
    "selected_item_ids", "omitted_item_ids", "required_coverage", "input",
    "output", "provider", "canonical_source_mutated", "rehydration_available"
  ],
  "properties": {
    "schema_version": {"const": "margos-child-context-receipt/v1"},
    "authority": {"const": "DERIVED_VIEW"},
    "handoff_policy_version": {"const": "margos-child-handoff-policy/v1"},
    "child_id": {"type": "string"},
    "role": {"enum": ["SCOUT", "WORKER", "VERIFIER", "INDEPENDENT_CRITIC"]},
    "route_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_context_view_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selected_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "omitted_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "input": {
      "type": "object",
      "required": ["items", "characters"],
      "properties": {
        "items": {"type": "integer", "minimum": 0},
        "characters": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["items", "characters_serialized", "payload_characters"],
      "properties": {
        "items": {"type": "integer", "minimum": 0},
        "characters_serialized": {"type": "integer", "minimum": 0},
        "payload_characters": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "provider": {"type": "object"},
    "canonical_source_mutated": {"const": false},
    "rehydration_available": {"type": "boolean"}
  },
  "additionalProperties": false
}
